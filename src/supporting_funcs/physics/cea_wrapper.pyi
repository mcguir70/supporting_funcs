from typing import overload

from supporting_funcs.coding.type_hints import FloatArray, FloatOrArray

from cea import Mixture as cea_Mixture
from cea import Reactant as cea_Reactant
from cea import RocketSolution as cea_RocketSolution
from cea import RocketSolver as cea_RocketSolver

class Propellent:
    def __init__(self, name: str | cea_Reactant,
                     percent_mass: float,
                     temperature: float = ...) -> None: ...
    @property
    def temperature(self) -> float | None: ...
    @temperature.setter
    def temperature(self, value: float | None): ...

    @property
    def name(self) -> str: ...
    @name.setter
    def name(self, value: str): ...

    @property
    def percent_mass(self) -> float: ...
    @percent_mass.setter
    def percent_mass(self, value: float): ...

    @property
    def cea_reactant(self) -> cea_Reactant: ...
    @cea_reactant.setter
    def cea_reactant(self, value: cea_Reactant): ...

class PropellentMixture:
    def __init__(self,
                 oxidizers: list[Propellent],
                 fuels: list[Propellent],
                 o_f_ratio: float) -> None: ...

    @property
    def oxidizer_weights(self) -> FloatArray: ...
    @property
    def fuel_weights(self) -> FloatArray: ...

    @property
    def fuels(self) -> list[Propellent]: ...
    @fuels.setter
    def fuels(self, value: list[Propellent]): ...

    @property
    def cea_fuel_list(self) -> list[cea_Reactant]: ...
    @property
    def fuel_temperatures(self) -> FloatArray: ...
    @property
    def oxidizers(self) -> list[Propellent]: ...
    @oxidizers.setter
    def oxidizers(self, value: list[Propellent]): ...

    @property
    def cea_oxidizer_list(self) -> list[cea_Reactant]: ...
    @property
    def oxidizer_temperatures(self) -> FloatArray: ...
    @property
    def cea_solver(self) -> cea_RocketSolver: ...
    @property
    def last_raw_solution(self) -> cea_RocketSolution: ...

    @property
    def o_f_ratio(self) -> float: ...
    @o_f_ratio.setter
    def o_f_ratio(self, value: float): ...

    @property
    def solution(self) -> CEAOutput: ...

    def _set_cea_solver(self) -> None:  ...

    def get_species(self) -> list[cea_Reactant | str]: ...

    def get_cea_reactants(self) -> cea_Mixture: ...

    def get_cea_products(self) -> cea_Mixture:  ...

    def get_o_f_weights(self, o_f_ratio: float) -> FloatArray: ...

    def solve(self, p_c: float,
              *,
              pi_p: FloatOrArray | None = None,
              ae_at: FloatOrArray | None = None,
              ) -> CEAOutput:  ...

    def resolve(self,
                *,
                p_c: float | None = None,
                o_f_ratio: float | None = None,
                ae_at: FloatOrArray | None = None,
                pi_p: FloatOrArray | None = None,
                ) -> CEAOutput: ...

class CEAOutput:
    def __init__(self, solution: cea_RocketSolution) -> None: ...

    @property
    def raw_solution(self) -> cea_RocketSolution: ...
    @raw_solution.setter
    def raw_solution(self, solution: cea_RocketSolution) -> None: ...

    @property
    def ae_at(self) -> FloatArray: ...

    @property
    def effective_exhaust_velocity_vacuum(self) -> FloatArray: ...
    @property
    def v_eff_v(self) -> FloatArray:
        """Alias for effective_exhaust_velocity_vacuum [m/s]."""
        ...

    @property
    def effective_exhaust_velocity_ideal(self) -> FloatArray: ...
    @property
    def v_eff_i(self) -> FloatArray:
        """Alias for effective_exhaust_velocity_ideal [m/s]."""
        ...

    @property
    def isp_vacuum(self) -> FloatArray: ...
    @property
    def isp_v(self) -> FloatArray:
        """Alias for isp_vacuum [s]."""
        ...

    @property
    def isp_ideal(self) -> FloatArray: ...
    @property
    def isp_i(self) -> FloatArray:
        """Alias for isp_ideal [s]."""
        ...

    @property
    def temperature(self) -> FloatArray: ...
    @property
    def T(self) -> FloatArray: #noqa: N802
        """Alias for temperature [K]."""
        ...

    @property
    def pressure(self) -> FloatArray: ...
    @property
    def P(self) -> FloatArray: #noqa: N802
        """Alias for pressure [Pa]."""
        ...

    @property
    def density(self) -> FloatArray: ...
    @property
    def rho(self) -> FloatArray:
        """Alias for density [kg/m³]."""
        ...

    @property
    def enthalpy(self) -> FloatArray: ...
    @property
    def h(self) -> FloatArray:
        """Alias for enthalpy [J]."""
        ...

    @property
    def internal_energy(self) -> FloatArray: ...
    @property
    def u(self) -> FloatArray:
        """Alias for internal_energy [J]."""
        ...

    @property
    def gibbs_energy(self) -> FloatArray: ...
    @property
    def g(self) -> FloatArray:
        """Alias for gibbs_energy [J]."""
        ...

    @property
    def entropy(self) -> FloatArray: ...
    @property
    def s(self) -> FloatArray:
        """Alias for entropy [J/K]."""
        ...

    @property
    def mach(self) -> FloatArray: ...
    # no M alias here to prevent confusion with molecular weight

    @property
    def overall_molecular_weight(self) -> FloatArray: ...

    @property
    def gaseous_molecular_weight(self) -> FloatArray: ...
    @property
    def MW_gas(self) -> FloatArray: #noqa: N802
        """Alias for gaseous_molecular_weight [kg/mol]."""
        ...

    @property
    def specific_heat_capacity_constant_pressure(self) -> FloatArray: ...
    @property
    def cp(self) -> FloatArray:
        """Alias for specific_heat_capacity_constant_pressure [J/(kg K)]."""
        ...

    @property
    def specific_heat_capacity_constant_volume(self) -> FloatArray: ...
    @property
    def cv(self) -> FloatArray:
        """Alias for specific_heat_capacity_constant_volume [J/(kg K)]."""
        ...
    @property
    def ratio_of_specific_heats_sonic(self) -> FloatArray: ...
    @property
    def gamma_s(self) -> FloatArray:
        """Alias for ratio_of_specific_heats_sonic [1]. May be different than cp/cv for real gas."""
        ...

    @property
    def characteristic_velocity(self) -> FloatArray: ...
    @property
    def c_star(self) -> FloatArray:
        """Alias for characteristic_velocity [m/s]."""
        ...

    @property
    def coefficient_of_thrust(self) -> FloatArray: ...
    @property
    def c_f(self) -> FloatArray: #noqa: N802
        """Alias for coefficient_of_thrust [1]."""
        ...

    @property
    def sonic_velocity(self) -> FloatArray: ...
    @property
    def c(self) -> FloatArray: #noqa: N802
        """Alias for sonic_velocity [m/s]."""
        ...

    @property
